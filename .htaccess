# RETIRED (2026-11-11). This case study moved into v2: its files live in
# micahburger/v2 at app/public/project/applicant-experience/ and are served
# at https://v2.micahburger.com/project/applicant-experience/. Make changes
# there, not here.
#
# Every request to applicants.micahburger.com is sent, permanently, to the
# same path under the new address (/screens/ to .../screens/, and so on),
# so links already sent out keep working. The files below this .htaccess
# are left as they were, unreachable, for the history.
#
# When v2 becomes micahburger.com, repoint the target (or let v2.'s own
# redirect carry it).

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # .well-known stays open for the host's SSL certificate checks, so the
  # https certificate the redirect is served over keeps renewing.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.*)$ https://v2.micahburger.com/project/applicant-experience/$1 [R=301,L]
</IfModule>
